{
  "name": "flight-plan-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Flight Plan (Rayleigh Solar Tech deliverable tracker)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "migrate:schema": "node -e \"console.log('Run: psql \\\"$DATABASE_URL\\\" -f db/schema.sql')\"",
    "migrate:import": "tsx scripts/migrate-from-export.ts"
  },
  "dependencies": {
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "openid-client": "^5.6.5",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
