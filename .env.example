DATABASE_URL=postgres://user:password@localhost:5432/flight_plan
SESSION_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=development

# Comma-separated emails allowed to advance the current week (cycle_config).
# There's no broader admin/role system by design -- this is the one place
# that needed a gate and didn't already have a natural owner.
ADMIN_EMAILS=victor@rayleighsolartech.com

# Microsoft Entra ID (Azure AD) SSO. Leave all three unset to run in dev-auth
# mode instead, where any request can identify itself with an
# `X-Dev-User-Email` header matching a row in `people`. Dev-auth mode refuses
# to start unless NODE_ENV=development.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/auth/callback
